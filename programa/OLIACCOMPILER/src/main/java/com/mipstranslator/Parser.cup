// === Control de flujo ===
instruccionCondicional ::= IF temporal:tempAux GOTO identificador:idAux
{:
    if(tempAux != null && idAux != null && TablaActual != null){
        String temp = tempAux.toString();
        String id = idAux.toString();
        String tempDestinoMIPS = AdminEntero.ObtenerRegistroMIPSDeIntermedio(temp);
        InstruccionMIPS instruccion = new InstruccionIfGoto(tempDestinoMIPS, id);
        TablaActual.AgregarInstruccion(instruccion);
    }
:}
                        | IFFALSE temporal:tempAux GOTO identificador:idAux
{:
    if(tempAux != null && idAux != null && TablaActual != null){
        String temp = tempAux.toString();
        String id = idAux.toString();
        String tempDestinoMIPS = AdminEntero.ObtenerRegistroMIPSDeIntermedio(temp);
        InstruccionMIPS instruccion = new InstruccionIfFalseGoto(tempDestinoMIPS, id);
        TablaActual.AgregarInstruccion(instruccion);
    }
:};

instruccionGoto ::= GOTO identificador:idAux
{:
    if(idAux != null && TablaActual != null){
        String id = idAux.toString();
        InstruccionMIPS instruccion = new InstruccionGoto(id);
        TablaActual.AgregarInstruccion(instruccion);
    }
:};

etiqueta ::= identificador:idAux COLON
{:
    if(idAux != null && TablaActual != null){
        String id = idAux.toString();
        InstruccionMIPS instruccion = new InstruccionEtiqueta(id);
        TablaActual.AgregarInstruccion(instruccion);
    }
:};

inicioFuncion ::= FUNCION identificador:idAux COLON
{:
    if(idAux != null){
        TablaSimbolos tabla = new TablaSimbolos(idAux.toString(), null);
        TablaActual = tabla;
        Tablas.add(tabla);
    }
:};